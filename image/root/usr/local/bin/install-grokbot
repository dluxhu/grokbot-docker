#!/usr/bin/env bash
# Install or update the official Grok Bot desktop app into $HOME.
#
#   install-grokbot            install the newest version, or update to it
#   install-grokbot --check    exit 0: current, 10: update available, 11: not installed
#   install-grokbot --remove   remove the app (your Grok Bot data stays)
#
# Source: the vendor's signed apt repository. The app goes into
# ~/.local/opt/grok-bot/<version>, on the /config volume. No root is needed.
set -euo pipefail

APP_TITLE="Grok Bot"
APP_PKG=grok-bot
APP_ROOT="${GROKBOT_HOME:-$HOME/.local/opt/grok-bot}"
APP_BIN=grok-bot
APP_DATA="$HOME/.config/Grok Bot"
REPO_URL=https://downloads.cursor.com/aptrepo
REPO_SUITE=grok-bot
REPO_COMPONENT=main
REPO_KEY="${GROKBOT_KEY:-/usr/share/grokbot-nas/grok-bot.asc}"

app_unpack() { mv "$1/opt/Grok Bot" "$2"; }

# Sign-in returns to the app through grokbot:// and sand:// links.
app_register() {
  ua_desktop_file "$1/usr/share/applications/grok-bot.desktop" \
    /usr/local/bin/grok-bot "$APP_ROOT/current/resources/icon.png" set-scheme-defaults
}

app_unregister() { rm -f "$APPS/grok-bot.desktop"; }

# shellcheck source=SCRIPTDIR/../lib/grokbot-nas/user-apt.sh
. "$(dirname "$(readlink -f "$0")")/../lib/grokbot-nas/user-apt.sh"
ua_main "$@"

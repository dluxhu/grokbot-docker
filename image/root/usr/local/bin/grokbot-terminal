#!/bin/bash
# Open a terminal window that runs one command, and wait until it closes.
#   grokbot-terminal [--hold] TITLE COMMAND [ARG...]
# The window stays open when the command fails, or always with --hold.
hold=0
if [ "${1:-}" = "--hold" ]; then hold=1; shift; fi
title="$1"; shift

# shellcheck disable=SC2016 # Expanded by the inner bash.
inner='"$@"; rc=$?
if [ "$rc" -ne 0 ] || [ "$HOLD" = 1 ]; then echo; read -r -p "Press Enter to close. " _; fi
exit "$rc"'

cd "$HOME" || exit 1
if [ "${PIXELFLUX_WAYLAND,,}" = "true" ]; then
  HOLD=$hold exec foot -T "$title" bash -c "$inner" bash "$@"
fi
HOLD=$hold exec xterm -T "$title" -e bash -c "$inner" bash "$@"

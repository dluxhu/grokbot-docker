# Copy to ".env" and fill in. Never commit the real .env.

# ── Container user ───────────────────────────────────────────────────────────
# Your NAS user and group. Run `id` over SSH to get them.
# 1026/100 is the usual first Synology admin and the "users" group.
PUID=1026
PGID=100
TZ=Etc/UTC

# The ONE host folder the container sees. It becomes /config (= $HOME).
# It holds Grok Bot, the agent CLIs, their logins, ssh keys and your projects.
# Create it first and make PUID:PGID its owner (see README).
HOME_DIR=/volume1/docker/grokbot/home

# ── Desktop (Grok Bot) ───────────────────────────────────────────────────────
# Login for the desktop in the browser. Required.
GUI_USER=abc
GUI_PASS=change-me-to-a-long-random-string
# https://your-nas:3001 (self-signed certificate). 3000 is plain HTTP, for a
# reverse proxy only.
GUI_HTTPS_PORT=3001
GUI_HTTP_PORT=3000

# true: install Grok Bot on first start, update it on each start.
# false: install and update by hand with `install-grokbot`.
GROKBOT_AUTO_UPDATE=true

# true: Wayland desktop (labwc). false: X11 desktop (Xvfb + Openbox).
# Try false if the desktop stays black.
PIXELFLUX_WAYLAND=true

# ── Optional terminal doors ──────────────────────────────────────────────────
# TTYD=1: web terminal on TTYD_PORT. TTYD_USER and TTYD_PASS are required.
TTYD=
TTYD_USER=admin
TTYD_PASS=change-me-too
TTYD_PORT=7681
# bash (default) or an agent command, for example claude.
TTYD_SHELL=bash

# SSHD=1: key-only ssh on SSH_PORT, user abc.
# Put your public key in <HOME_DIR>/.ssh/authorized_keys first.
SSHD=
SSH_PORT=2222

# ── Other ────────────────────────────────────────────────────────────────────
# Optional. From `claude setup-token`; lets `claude -p` run without a login.
CLAUDE_CODE_OAUTH_TOKEN=

# Extra Debian packages for a local build (--build), space-separated.
EXTRA_PACKAGES=

CONTAINER_NAME=grokbot
CONTAINER_HOSTNAME=grokbot
